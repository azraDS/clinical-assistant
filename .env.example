# Copy to .env (never commit the real file — it is gitignored and blocked by pre-commit).
OPENAI_API_KEY=

# Optional: Langfuse tracing. Leave blank to run untraced.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Only needed outside Langfuse's default US cloud region (EU cloud / self-hosted).
LANGFUSE_BASE_URL=
